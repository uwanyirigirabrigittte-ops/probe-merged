database_url=postgresql://postgres:postgres@localhost:5432/probe-db
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15

# HiveMQ MQTT Broker Configuration
MQTT_BROKER=your-hivemq-broker-url.com
MQTT_PORT=8883
MQTT_TOPIC=probe/telemetry/+
MQTT_USER=your-hivemq-username
MQTT_PASSWORD=your-hivemq-password
MQTT_KEEPALIVE=60

# Email Configuration (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=probe@yourdomain.com
FRONTEND_URL=http://localhost:3000
